(declare-var counter Real)
(declare-var counter_prime Real)
(declare-var x0 Real)
(declare-var x1 Real)
(declare-var x0_prime Real)
(declare-var x1_prime Real)
(declare-var w0 (Array Real (Array Real Real)))
(declare-var w1 (Array Real (Array Real Real)))
(declare-var w0_prime (Array Real (Array Real Real)))
(declare-var w1_prime (Array Real (Array Real Real)))
(declare-var b0 (Array Real Real))
(declare-var b1 (Array Real Real))
(declare-var b0_prime (Array Real Real))
(declare-var b1_prime (Array Real Real))
(define-fun max ((a Real) (b Real)) Real (ite (> a b) a b))
(define-fun ReLU ((a Real) (b Real) (c Real)) Real (ite (= c 4) a (max a b)))
(declare-rel inv ((Real)(Real) (Real) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real Real) (Array Real Real)))
(declare-rel fail ())

(rule
	(=>
		(and
			(= x0 0.9059)
			(= x1 0.5839)
			(= counter 0)
			(= (select (select w0 0) 0) 0.7007)
			(= (select (select w0 1) 0) 1.6783)
			(= (select (select w1 0) 0) 0.3903)
			(= (select (select w1 1) 0) -0.4735)
			(= (select (select w0 0) 1) -0.4663)
			(= (select (select w0 1) 1) 0.8883)
			(= (select (select w1 0) 1) 1.6677)
			(= (select (select w1 1) 1) -0.7448)
			(= (select (select w0 0) 2) 0.349)
			(= (select (select w0 1) 2) -0.0846)
			(= (select (select w1 0) 2) 1.3031)
			(= (select (select w1 1) 2) 0.809)
			(= (select (select w0 0) 3) -0.9305)
			(= (select (select w0 1) 3) -0.0367)
			(= (select (select w1 0) 3) 0.7886)
			(= (select (select w1 1) 3) 0.2997)
			(= (select (select w0 0) 4) -0.4569)
			(= (select (select w0 1) 4) 0.43)
			(= (select (select w1 0) 4) 0)
			(= (select (select w1 1) 4) 0)
			(= (select b0 0) 0.0498)
			(= (select b1 0) 0.0026)
			(= (select b0 1) -0.0547)
			(= (select b1 1) 0.0604)
			(= (select b0 2) -0.013)
			(= (select b1 2) 0.0186)
			(= (select b0 3) 0.0166)
			(= (select b1 3) 0.0166)
			(= (select b0 4) -0.2345)
			(= (select b1 4) 0)
		)
		(inv counter x0 x1 w0 w1 b0 b1)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 w0 w1 b0 b1)
			(= x0_prime (ReLU (+ (* (select (select w0 0) counter) x0) (* (select (select w0 1) counter) x1) (select b0 counter)) 0 counter))
			(= x1_prime (ReLU (+ (* (select (select w1 0) counter) x0) (* (select (select w1 1) counter) x1) (select b1 counter)) 0 counter))
			(= w0_prime w0)
			(= w1_prime w1)
			(= b0_prime b0)
			(= b1_prime b1)
			(= counter_prime (+ counter 1))
			(or (= counter 0) (= counter 1) (= counter 2) (= counter 3) (= counter 4))
		)
		(inv counter_prime x0_prime x1_prime w0_prime w1_prime b0_prime b1_prime)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 w0 w1 b0 b1)
			(not (>= x0 0))
			(>= counter 5)
		)
		fail
	)
)

(query fail)
