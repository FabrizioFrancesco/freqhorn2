(declare-var counter Real)
(declare-var counter_prime Real)
(declare-var x0 Real)
(declare-var x1 Real)
(declare-var x2 Real)
(declare-var x0_prime Real)
(declare-var x1_prime Real)
(declare-var x2_prime Real)
(declare-var w0 (Array Real (Array Real Real)))
(declare-var w1 (Array Real (Array Real Real)))
(declare-var w2 (Array Real (Array Real Real)))
(declare-var w0_prime (Array Real (Array Real Real)))
(declare-var w1_prime (Array Real (Array Real Real)))
(declare-var w2_prime (Array Real (Array Real Real)))
(declare-var b0 (Array Real Real))
(declare-var b1 (Array Real Real))
(declare-var b2 (Array Real Real))
(declare-var b0_prime (Array Real Real))
(declare-var b1_prime (Array Real Real))
(declare-var b2_prime (Array Real Real))
(define-fun max ((a Real) (b Real)) Real (ite (> a b) a b))
(define-fun ReLU ((a Real) (b Real) (c Real)) Real (ite (= c 4) a (max a b)))
(declare-rel inv ((Real)(Real) (Real) (Real) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real Real) (Array Real Real) (Array Real Real)))
(declare-rel fail ())

(rule
	(=>
		(and
			(= x0 0.5689)
			(= x1 0.6984)
			(= x2 0.6948)
			(= counter 0)
			(= (select (select w0 0) 0) -0.8914)
			(= (select (select w0 1) 0) -0.0919)
			(= (select (select w0 2) 0) 0.297)
			(= (select (select w1 0) 0) -1.326)
			(= (select (select w1 1) 0) -0.7262)
			(= (select (select w1 2) 0) -1.0572)
			(= (select (select w2 0) 0) -0.8555)
			(= (select (select w2 1) 0) 0.6787)
			(= (select (select w2 2) 0) -0.537)
			(= (select (select w0 0) 1) 0.1751)
			(= (select (select w0 1) 1) 0.511)
			(= (select (select w0 2) 1) -0.0264)
			(= (select (select w1 0) 1) 0.4363)
			(= (select (select w1 1) 1) -0.2561)
			(= (select (select w1 2) 1) 1.1846)
			(= (select (select w2 0) 1) -1.1085)
			(= (select (select w2 1) 1) 0.1521)
			(= (select (select w2 2) 1) 0.0677)
			(= (select (select w0 0) 2) 0.5872)
			(= (select (select w0 1) 2) -0.3194)
			(= (select (select w0 2) 2) -1.3424)
			(= (select (select w1 0) 2) 0.9361)
			(= (select (select w1 1) 2) -0.4969)
			(= (select (select w1 2) 2) -0.5915)
			(= (select (select w2 0) 2) 0.2781)
			(= (select (select w2 1) 2) -0.2938)
			(= (select (select w2 2) 2) 0.0246)
			(= (select (select w0 0) 3) 1.4012)
			(= (select (select w0 1) 3) -0.8933)
			(= (select (select w0 2) 3) -1.2252)
			(= (select (select w1 0) 3) 0.0486)
			(= (select (select w1 1) 3) -0.3081)
			(= (select (select w1 2) 3) 0.4015)
			(= (select (select w2 0) 3) 1.2043)
			(= (select (select w2 1) 3) -0.6728)
			(= (select (select w2 2) 3) 0.8024)
			(= (select (select w0 0) 4) 0.35)
			(= (select (select w0 1) 4) -0.7518)
			(= (select (select w0 2) 4) 0.3591)
			(= (select (select w1 0) 4) 0)
			(= (select (select w1 1) 4) 0)
			(= (select (select w1 2) 4) 0)
			(= (select (select w2 0) 4) 0)
			(= (select (select w2 1) 4) 0)
			(= (select (select w2 2) 4) 0)
			(= (select b0 0) -0.0974)
			(= (select b1 0) 0.0858)
			(= (select b2 0) 0.0054)
			(= (select b0 1) -0.0214)
			(= (select b1 1) -0.0969)
			(= (select b2 1) -0.0221)
			(= (select b0 2) 0.0292)
			(= (select b1 2) -0.0935)
			(= (select b2 2) -0.0537)
			(= (select b0 3) 0.0347)
			(= (select b1 3) 0.0951)
			(= (select b2 3) 0.0326)
			(= (select b0 4) 0.0226)
			(= (select b1 4) 0)
			(= (select b2 4) 0)
		)
		(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
			(= x0_prime (ReLU (+ (* (select (select w0 0) counter) x0) (* (select (select w0 1) counter) x1) (* (select (select w0 2) counter) x2) (select b0 counter)) 0 counter))
			(= x1_prime (ReLU (+ (* (select (select w1 0) counter) x0) (* (select (select w1 1) counter) x1) (* (select (select w1 2) counter) x2) (select b1 counter)) 0 counter))
			(= x2_prime (ReLU (+ (* (select (select w2 0) counter) x0) (* (select (select w2 1) counter) x1) (* (select (select w2 2) counter) x2) (select b2 counter)) 0 counter))
			(= w0_prime w0)
			(= w1_prime w1)
			(= w2_prime w2)
			(= b0_prime b0)
			(= b1_prime b1)
			(= b2_prime b2)
			(= counter_prime (+ counter 1))
			(or (= counter 0) (= counter 1) (= counter 2) (= counter 3) (= counter 4))
		)
		(inv counter_prime x0_prime x1_prime x2_prime w0_prime w1_prime w2_prime b0_prime b1_prime b2_prime)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
			(not (>= x0 0))
			(>= counter 5)
		)
		fail
	)
)

(query fail)
