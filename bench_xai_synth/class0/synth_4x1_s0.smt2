(declare-var counter Real)
(declare-var counter_prime Real)
(declare-var x0 Real)
(declare-var x1 Real)
(declare-var x2 Real)
(declare-var x3 Real)
(declare-var x0_prime Real)
(declare-var x1_prime Real)
(declare-var x2_prime Real)
(declare-var x3_prime Real)
(declare-var w0 (Array Real (Array Real Real)))
(declare-var w1 (Array Real (Array Real Real)))
(declare-var w2 (Array Real (Array Real Real)))
(declare-var w3 (Array Real (Array Real Real)))
(declare-var w0_prime (Array Real (Array Real Real)))
(declare-var w1_prime (Array Real (Array Real Real)))
(declare-var w2_prime (Array Real (Array Real Real)))
(declare-var w3_prime (Array Real (Array Real Real)))
(declare-var b0 (Array Real Real))
(declare-var b1 (Array Real Real))
(declare-var b2 (Array Real Real))
(declare-var b3 (Array Real Real))
(declare-var b0_prime (Array Real Real))
(declare-var b1_prime (Array Real Real))
(declare-var b2_prime (Array Real Real))
(declare-var b3_prime (Array Real Real))
(define-fun max ((a Real) (b Real)) Real (ite (> a b) a b))
(define-fun ReLU ((a Real) (b Real) (c Real)) Real (ite (= c 1) a (max a b)))
(declare-rel inv ((Real)(Real) (Real) (Real) (Real) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real Real) (Array Real Real) (Array Real Real) (Array Real Real)))
(declare-rel fail ())

(rule
	(=>
		(and
			(= x0 0.0347)
			(= x1 0.2340)
			(= x2 0.3184)
			(= x3 0.1468)
			(= counter 0)
			(= (select (select w0 0) 0) -0.7617)
			(= (select (select w0 1) 0) -1.156)
			(= (select (select w0 2) 0) 1.0501)
			(= (select (select w0 3) 0) -0.1487)
			(= (select (select w1 0) 0) -1.1145)
			(= (select (select w1 1) 0) 0.5179)
			(= (select (select w1 2) 0) -0.066)
			(= (select (select w1 3) 0) 0.9101)
			(= (select (select w2 0) 0) 0.2323)
			(= (select (select w2 1) 0) 0.9411)
			(= (select (select w2 2) 0) 0.6613)
			(= (select (select w2 3) 0) -0.1303)
			(= (select (select w3 0) 0) -0.8449)
			(= (select (select w3 1) 0) 1.1121)
			(= (select (select w3 2) 0) -1.1345)
			(= (select (select w3 3) 0) 0.6178)
			(= (select (select w0 0) 1) 1.0532)
			(= (select (select w0 1) 1) 1.1162)
			(= (select (select w0 2) 1) 1.0579)
			(= (select (select w0 3) 1) 0.7878)
			(= (select (select w1 0) 1) 0)
			(= (select (select w1 1) 1) 0)
			(= (select (select w1 2) 1) 0)
			(= (select (select w1 3) 1) 0)
			(= (select (select w2 0) 1) 0)
			(= (select (select w2 1) 1) 0)
			(= (select (select w2 2) 1) 0)
			(= (select (select w2 3) 1) 0)
			(= (select (select w3 0) 1) 0)
			(= (select (select w3 1) 1) 0)
			(= (select (select w3 2) 1) 0)
			(= (select (select w3 3) 1) 0)
			(= (select b0 0) 0.0897)
			(= (select b1 0) 0.094)
			(= (select b2 0) -0.0056)
			(= (select b3 0) 0.0449)
			(= (select b0 1) -1.3055)
			(= (select b1 1) 0)
			(= (select b2 1) 0)
			(= (select b3 1) 0)
		)
		(inv counter x0 x1 x2 x3 w0 w1 w2 w3 b0 b1 b2 b3)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 x3 w0 w1 w2 w3 b0 b1 b2 b3)
			(= x0_prime (ReLU (+ (* (select (select w0 0) counter) x0) (* (select (select w0 1) counter) x1) (* (select (select w0 2) counter) x2) (* (select (select w0 3) counter) x3) (select b0 counter)) 0 counter))
			(= x1_prime (ReLU (+ (* (select (select w1 0) counter) x0) (* (select (select w1 1) counter) x1) (* (select (select w1 2) counter) x2) (* (select (select w1 3) counter) x3) (select b1 counter)) 0 counter))
			(= x2_prime (ReLU (+ (* (select (select w2 0) counter) x0) (* (select (select w2 1) counter) x1) (* (select (select w2 2) counter) x2) (* (select (select w2 3) counter) x3) (select b2 counter)) 0 counter))
			(= x3_prime (ReLU (+ (* (select (select w3 0) counter) x0) (* (select (select w3 1) counter) x1) (* (select (select w3 2) counter) x2) (* (select (select w3 3) counter) x3) (select b3 counter)) 0 counter))
			(= w0_prime w0)
			(= w1_prime w1)
			(= w2_prime w2)
			(= w3_prime w3)
			(= b0_prime b0)
			(= b1_prime b1)
			(= b2_prime b2)
			(= b3_prime b3)
			(= counter_prime (+ counter 1))
			(or (= counter 0) (= counter 1))
		)
		(inv counter_prime x0_prime x1_prime x2_prime x3_prime w0_prime w1_prime w2_prime w3_prime b0_prime b1_prime b2_prime b3_prime)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 x3 w0 w1 w2 w3 b0 b1 b2 b3)
			(not (< x0 0))
			(>= counter 2)
		)
		fail
	)
)

(query fail)
