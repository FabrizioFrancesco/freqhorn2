(declare-var counter Real)
(declare-var counter_prime Real)
(declare-var x0 Real)
(declare-var x1 Real)
(declare-var x2 Real)
(declare-var x0_prime Real)
(declare-var x1_prime Real)
(declare-var x2_prime Real)
(declare-var w0 (Array Real (Array Real Real)))
(declare-var w1 (Array Real (Array Real Real)))
(declare-var w2 (Array Real (Array Real Real)))
(declare-var w0_prime (Array Real (Array Real Real)))
(declare-var w1_prime (Array Real (Array Real Real)))
(declare-var w2_prime (Array Real (Array Real Real)))
(declare-var b0 (Array Real Real))
(declare-var b1 (Array Real Real))
(declare-var b2 (Array Real Real))
(declare-var b0_prime (Array Real Real))
(declare-var b1_prime (Array Real Real))
(declare-var b2_prime (Array Real Real))
(define-fun max ((a Real) (b Real)) Real (ite (> a b) a b))
(define-fun ReLU ((a Real) (b Real) (c Real)) Real (ite (= c 5) a (max a b)))
(declare-rel inv ((Real)(Real) (Real) (Real) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real Real) (Array Real Real) (Array Real Real)))
(declare-rel fail ())

(rule
	(=>
		(and
			(= x0 0.4500)
			(= x1 0.0728)
			(= x2 0.0965)
			(= counter 0)
			(= (select (select w0 0) 0) -1.2694)
			(= (select (select w0 1) 0) -0.756)
			(= (select (select w0 2) 0) 0.3267)
			(= (select (select w1 0) 0) 1.1102)
			(= (select (select w1 1) 0) -0.328)
			(= (select (select w1 2) 0) 1.2601)
			(= (select (select w2 0) 0) -0.4064)
			(= (select (select w2 1) 0) 0.4285)
			(= (select (select w2 2) 0) -0.4524)
			(= (select (select w0 0) 1) -0.0084)
			(= (select (select w0 1) 1) 0.1775)
			(= (select (select w0 2) 1) -1.0284)
			(= (select (select w1 0) 1) -1.007)
			(= (select (select w1 1) 1) 0.8134)
			(= (select (select w1 2) 1) -0.6519)
			(= (select (select w2 0) 1) -0.1443)
			(= (select (select w2 1) 1) -0.6242)
			(= (select (select w2 2) 1) -0.5603)
			(= (select (select w0 0) 2) 1.0142)
			(= (select (select w0 1) 2) 0.2415)
			(= (select (select w0 2) 2) -0.9885)
			(= (select (select w1 0) 2) 0.9635)
			(= (select (select w1 1) 2) 1.0745)
			(= (select (select w1 2) 2) -0.2746)
			(= (select (select w2 0) 2) 0.7705)
			(= (select (select w2 1) 2) 0.1487)
			(= (select (select w2 2) 2) 0.7221)
			(= (select (select w0 0) 3) 0.1323)
			(= (select (select w0 1) 3) 0.0576)
			(= (select (select w0 2) 3) -1.147)
			(= (select (select w1 0) 3) 0.4262)
			(= (select (select w1 1) 3) -0.7698)
			(= (select (select w1 2) 3) -0.7125)
			(= (select (select w2 0) 3) 1.3323)
			(= (select (select w2 1) 3) 1.1563)
			(= (select (select w2 2) 3) 0.4514)
			(= (select (select w0 0) 4) -0.7174)
			(= (select (select w0 1) 4) 1.203)
			(= (select (select w0 2) 4) -0.8725)
			(= (select (select w1 0) 4) 0.3996)
			(= (select (select w1 1) 4) -0.8478)
			(= (select (select w1 2) 4) 0.3503)
			(= (select (select w2 0) 4) 1.2483)
			(= (select (select w2 1) 4) 0.7334)
			(= (select (select w2 2) 4) -0.1077)
			(= (select (select w0 0) 5) 0.8293)
			(= (select (select w0 1) 5) 0.0745)
			(= (select (select w0 2) 5) 0.0909)
			(= (select (select w1 0) 5) 0)
			(= (select (select w1 1) 5) 0)
			(= (select (select w1 2) 5) 0)
			(= (select (select w2 0) 5) 0)
			(= (select (select w2 1) 5) 0)
			(= (select (select w2 2) 5) 0)
			(= (select b0 0) -0.0286)
			(= (select b1 0) -0.0628)
			(= (select b2 0) 0.0401)
			(= (select b0 1) -0.0321)
			(= (select b1 1) 0.0641)
			(= (select b2 1) 0.0612)
			(= (select b0 2) 0.0018)
			(= (select b1 2) 0.0043)
			(= (select b2 2) 0.0858)
			(= (select b0 3) -0.094)
			(= (select b1 3) 0.0023)
			(= (select b2 3) -0.0639)
			(= (select b0 4) -0.0155)
			(= (select b1 4) -0.0893)
			(= (select b2 4) 0.0979)
			(= (select b0 5) -0.0375)
			(= (select b1 5) 0)
			(= (select b2 5) 0)
		)
		(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
			(= x0_prime (ReLU (+ (* (select (select w0 0) counter) x0) (* (select (select w0 1) counter) x1) (* (select (select w0 2) counter) x2) (select b0 counter)) 0 counter))
			(= x1_prime (ReLU (+ (* (select (select w1 0) counter) x0) (* (select (select w1 1) counter) x1) (* (select (select w1 2) counter) x2) (select b1 counter)) 0 counter))
			(= x2_prime (ReLU (+ (* (select (select w2 0) counter) x0) (* (select (select w2 1) counter) x1) (* (select (select w2 2) counter) x2) (select b2 counter)) 0 counter))
			(= w0_prime w0)
			(= w1_prime w1)
			(= w2_prime w2)
			(= b0_prime b0)
			(= b1_prime b1)
			(= b2_prime b2)
			(= counter_prime (+ counter 1))
			(or (= counter 0) (= counter 1) (= counter 2) (= counter 3) (= counter 4) (= counter 5))
		)
		(inv counter_prime x0_prime x1_prime x2_prime w0_prime w1_prime w2_prime b0_prime b1_prime b2_prime)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
			(not (< x0 0))
			(>= counter 6)
		)
		fail
	)
)

(query fail)
