; toyCHC_ReLU_s3.smt2 without arrays, in CHC-COMP format (Golem).
; Generated by encoding_no_arrays/remove_arrays.py: same predicate and rules,
; the weight/bias arrays are replaced by the constants the fact gives them, split on the values of counter.
(set-logic HORN)

(declare-fun inv (Real Real Real Real) Bool)

(assert
	(forall ((counter Real) (x0 Real) (x1 Real) (x2 Real))
		(=>
			(and
				(= x0 3.14)
				(= x1 0.0)
				(= x2 0.0)
				(= counter 0.0)
			)
			(inv counter x0 x1 x2)
		)
	)
)

(assert
	(forall ((counter Real) (counter_prime Real) (x0 Real) (x1 Real) (x2 Real) (x0_prime Real) (x1_prime Real) (x2_prime Real))
		(=>
			(and
				(inv counter x0 x1 x2)
				(= x0_prime
					(ite (= counter 0.0) (let ((a_1 (+ (* 2.0 x0) (* 0.0 x1) (* 1.0 x2) 0.0))) (ite (> a_1 0.0) a_1 0.0))
					(+ (* 1.0 x0) (* (- 4.0) x1) (* 0.0 x2) 0.0)))
				(= x1_prime
					(ite (= counter 0.0) (let ((a_3 (+ (* (- 1.0) x0) (* 1.0 x1) (* (- 1.0) x2) 0.0))) (ite (> a_3 0.0) a_3 0.0))
					(+ (* 0.0 x0) (* 0.0 x1) (* 0.0 x2) 0.0)))
				(= x2_prime
					(ite (= counter 0.0) (let ((a_5 (+ (* 0.0 x0) (* 0.0 x1) (* 0.0 x2) 0.0))) (ite (> a_5 0.0) a_5 0.0))
					(+ (* 0.0 x0) (* 0.0 x1) (* 0.0 x2) 0.0)))
				(= counter_prime (+ counter 1.0))
				(or (= counter 0.0) (= counter 1.0))
			)
			(inv counter_prime x0_prime x1_prime x2_prime)
		)
	)
)

(assert
	(forall ((counter Real) (x0 Real) (x1 Real) (x2 Real))
		(=>
			(and
				(inv counter x0 x1 x2)
				(not (and (>= x0 x1) (>= x0 x2)))
				(>= counter 2.0)
			)
			false
		)
	)
)

(check-sat)
