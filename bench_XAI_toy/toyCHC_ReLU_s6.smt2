(declare-var counter Int)
(declare-var counter_prime Int)
(declare-var x0 Real)
(declare-var x1 Real)
(declare-var x2 Real)
(declare-var x0_prime Real)
(declare-var x1_prime Real)
(declare-var x2_prime Real)
(declare-var w0 (Array Real (Array Real Real)))
(declare-var w1 (Array Real (Array Real Real)))
(declare-var w2 (Array Real (Array Real Real)))
(declare-var w0_prime (Array Real (Array Real Real)))
(declare-var w1_prime (Array Real (Array Real Real)))
(declare-var w2_prime (Array Real (Array Real Real)))
(declare-var b0 (Array Real Real))
(declare-var b1 (Array Real Real))
(declare-var b2 (Array Real Real))
(declare-var b0_prime (Array Real Real))
(declare-var b1_prime (Array Real Real))
(declare-var b2_prime (Array Real Real))
(define-fun max ((a Real) (b Real)) Real (ite (> a b) a b))
(define-fun ReLU ((a Real) (b Real) (c Real)) Real (ite (= c 1) a (max a b)))
(declare-rel inv (Int Real Real Real (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real (Array Real Real)) (Array Real Real) (Array Real Real) (Array Real Real)))
(declare-rel fail ())

(rule
	(=>
		(and
			(= x0 3.64)
			(= x1 0)
			(= x2 0)
			(= counter 0)
			(= (select (select w0 0) 0) 2.0)
			(= (select (select w0 1) 0) 0.0)
			(= (select (select w0 2) 0) 1.0)
			(= (select (select w1 0) 0) -1.0)
			(= (select (select w1 1) 0) 1.0)
			(= (select (select w1 2) 0) -1.0)
			(= (select (select w2 0) 0) 0.0)
			(= (select (select w2 1) 0) 0.0)
			(= (select (select w2 2) 0) 0.0)
			(= (select (select w0 0) 1) 1.0)
			(= (select (select w0 1) 1) -4.0)
			(= (select (select w0 2) 1) 0.0)
			(= (select (select w1 0) 1) 0.0)
			(= (select (select w1 1) 1) 0.0)
			(= (select (select w1 2) 1) 0.0)
			(= (select (select w2 0) 1) 0.0)
			(= (select (select w2 1) 1) 0.0)
			(= (select (select w2 2) 1) 0.0)
			(= (select b0 0) 0.0)
			(= (select b1 0) 0.0)
			(= (select b2 0) 0.0)
			(= (select b0 1) 0.0)
			(= (select b1 1) 0.0)
			(= (select b2 1) 0.0)
		)
		(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
			(= x0_prime (ReLU (+ (* (select (select w0 0) counter) x0) (* (select (select w0 1) counter) x1) (* (select (select w0 2) counter) x2) (select b0 counter)) 0 counter))
			(= x1_prime (ReLU (+ (* (select (select w1 0) counter) x0) (* (select (select w1 1) counter) x1) (* (select (select w1 2) counter) x2) (select b1 counter)) 0 counter))
			(= x2_prime (ReLU (+ (* (select (select w2 0) counter) x0) (* (select (select w2 1) counter) x1) (* (select (select w2 2) counter) x2) (select b2 counter)) 0 counter))
			(= w0_prime w0)
			(= w1_prime w1)
			(= w2_prime w2)
			(= b0_prime b0)
			(= b1_prime b1)
			(= b2_prime b2)
			(= counter_prime (+ counter 1))
			(or (= counter 0) (= counter 1))
		)
		(inv counter_prime x0_prime x1_prime x2_prime w0_prime w1_prime w2_prime b0_prime b1_prime b2_prime)
	)
)

(rule
	(=>
		(and
			(inv counter x0 x1 x2 w0 w1 w2 b0 b1 b2)
			(not (and (>= x0 x1) (>= x0 x2)))
			(>= counter 2)
		)
		fail
	)
)

(query fail)
